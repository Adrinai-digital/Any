<!-- views/metodo_learn.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Método Learn - Mis Citas</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container citas-container">
 <h1 class="page-title">Método Learn</h1>

 <p class="citas-intro">
 Hola, <strong><%= usuario.nombre %></strong>.<br>
 Estas son tus citas para este curso:
 </p>

 <% const ahora = new Date(); %>

 <div class="citas-list">
 <% if (!citas || citas.length === 0) { %>
 <p class="citas-empty">No tienes citas agendadas aún.</p>
 <% } else { %>
 <% citas.forEach(cita => { 
 const fechaCita = new Date(cita.fecha);
 const esPasada = fechaCita < ahora;
 %>
 <div class="cita-item">
 <div class="cita-header">
 <div class="cita-fecha-hora">
 <p class="cita-fecha">
 <span class="label">Fecha:</span>
 <span class="value">
 <%= fechaCita.toLocaleDateString('es-ES') %>
 </span>
 </p>
 <p class="cita-hora">
 <span class="label">Hora:</span>
 <span class="value"><%= cita.hora %></span>
 </p>
 </div>

 <div class="cita-estado-wrapper">
 <span class="label">Estado:</span>

 <% if (esPasada) { %>
 <span class="cita-estado estado-finalizada">✅ Finalizada</span>
 <% } else { %>
 <span class="cita-estado
 <% if (cita.estado === 'pagado') { %> estado-confirmada <% } %>
 <% if (cita.estado === 'pendiente') { %> estado-pendiente <% } %>
 <% if (cita.estado !== 'pagado' && cita.estado !== 'pendiente') { %> estado-cancelada <% } %>
 ">
 <% if (cita.estado === 'pagado') { %>
 🟢 Confirmada
 <% } else if (cita.estado === 'pendiente') { %>
 🟡 Pendiente
 <% } else { %>
 🔴 Cancelada
 <% } %>
 </span>
 <% } %>
 </div>
 </div>

 <% if (cita.observaciones) { %>
 <p class="cita-observaciones">
 <span class="label">Observaciones:</span>
 <span class="value"><%= cita.observaciones %></span>
 </p>
 <% } %>
 </div>
 <% }) %>
 <% } %>
 </div>

 <a href="/perfil" class="btn btn-secondary volver-perfil">← Volver a mi perfil</a>
</div>

</body>
</html>
